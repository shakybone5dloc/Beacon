@page "/"
@rendermode InteractiveServer
@inject IBeaconApiClient Api

<PageTitle>Beacon · Board</PageTitle>

<h1>Applications</h1>
<p><a class="new" href="/applications/new">+ New Application</a></p>

@if (_applications is null)
{
    <p>Loading...</p>
}
else
{
    @if (_message is not null)
    {
        <p class="notice">@_message</p>
    }
    <div class="board">
        @foreach (var status in Columns)
        {
            var cards = ForStatus(status).ToList();

            <section class="column">
                <h2>@status <span class="count">@cards.Count</span></h2>
                @foreach (var application in cards)
                {
                    <article class="card">
                        <strong><a href="/applications/@application.Id">@application.Company</a></strong>
                        <span>@application.Role</span>
                        @if (application.AllowedTransitions.Count > 0)
                        {
                            <div class="actions">
                                @foreach (var target in application.AllowedTransitions)
                                {
                                    <button disabled="@_busy" @onclick="() => MoveAsync(application, target)">@target</button>
                                }
                            </div>
                        }
                    </article>
                }
            </section>
        }
    </div>
}

@code {
    private static readonly string[] Columns = ["Saved", "Applied", "Interviewing", "Offer", "Rejected", "Withdrawn"];

    private List<ApplicationResponse>? _applications;
    private bool _busy;
    private string? _message;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync() =>
        _applications = (await Api.GetApplicationsAsync()).ToList();

    private IEnumerable<ApplicationResponse> ForStatus(string status) =>
        _applications!.Where(a => a.Status == status);

    private async Task MoveAsync(ApplicationResponse application, string target)
    {
        _busy = true;
        _message = null;
        try
        {
            var result = await Api.ChangeStatusAsync(application.Id, target, application.Version);

            switch (result.Outcome)
            {
                case MoveOutcome.Moved:
                    var index = _applications.FindIndex(a => a.Id == application.Id);
                    _applications[index] = result.Application!;
                    break;
                case MoveOutcome.Conflict:
                    _message = "This application was changed somewhere else. The board has been refreshed.";
                    await LoadAsync();
                    break;
                case MoveOutcome.NotFound:
                    _message = result.Message;
                    await LoadAsync();
                    break;
            }
        }
        finally
        {
            _busy = false;
        }
    }
}