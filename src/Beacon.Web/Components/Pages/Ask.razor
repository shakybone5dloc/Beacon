@page "/ask"
@rendermode InteractiveServer
@implements IDisposable
@using System.Text
@using System.Text.RegularExpressions
@inject IBeaconApiClient Api

<PageTitle>Beacon · Ask</PageTitle>

<h1>Ask Beacon</h1>

<form class="ask" @onsubmit="AskAsync">
    <textarea @bind="_question" @bind:event="oninput" rows="3"
        placeholder="Which of my skills match the Contoso job, and what am i missing?"></textarea>
    <div class="buttons">
        <button type="submit" disabled="@(_asking || string.IsNullOrWhiteSpace(_question))">Ask</button>
        @if (_asking)
        {
            <button type="button" @onclick="Stop">Stop</button>
        }
    </div>
</form>

@if (_answer.Length > 0)
{
    <div class="answer">
        @foreach (var (text, source) in Segments(_answer.ToString()))
        {
            if (source is null)
            {
                @text
            }
            else
            {
                <abbr class="cite" href="#source-@source">@text</abbr>
            }
        }
        @if (_asking)
        {
            <span class="cursor">▍</span>                 
        }
    </div>
}

@if (_grounded == false && _error is null)
{
    <p class="hint">This answer isn't based on your documents.</p>
}

@if (_sources.Count > 0)
{
    <h2>Sources</h2>
    <ol class="srouces">
        @foreach (var s in _sources)
        {
            <li id="source-@s.Number">
                <strong>@s.FileName</strong> <span class="score">(@s.Score.ToString("0.00"))</span>
                    <p>@s.Text</p>
            </li>
        }
    </ol>
}

@code {
    private static readonly Regex Citation = new(@"\[(\d+)\]", RegexOptions.Compiled);

    private string _question = "";
    private bool _asking;
    private readonly StringBuilder _answer = new();
    private List<AskSource> _sources = [];
    private string? _error;
    private bool? _grounded;
    private CancellationTokenSource? _cts;

    private async Task AskAsync()
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();

        _asking = true;
        _answer.Clear();
        _sources = [];
        _error = null;
        _grounded = null;

        try
        {
            await foreach (var evt in Api.AskAsync(_question, null, _cts.Token))
            {
                switch (evt)
                {
                    case SourcesEvent s:
                        _sources = s.Sources.ToList();
                        break;

                    case TokenEvent t:
                        _answer.Append(t.Text);
                        break;

                    case ErrorEvent e:
                        _error = e.Message;
                        break;

                    case DoneEvent d:
                        _grounded = d.Grounded;
                        break;
                }

                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {

        }
        finally
        {
            _asking = false;
        }
    }

    private void Stop()
    {
        _cts?.Cancel();
    }

    private static IEnumerable<(string Text, int? Source)> Segments(string answer)
    {
        var last = 0;
        foreach (Match m in Citation.Matches(answer))
        {
            if (m.Index > last)
                yield return (answer[last..m.Index], null);
            yield return (m.Value, int.Parse(m.Groups[1].Value));
            last = m.Index + m.Length;
        }
        if (last < answer.Length)
            yield return (answer[last..], null);
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
